meta {
  name: Create Contact
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/contacts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body {
  {
    "name": "John Doe",
    "email": "john@example.com",
    "phone": "+1234567890"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  setvar contact_id = res.body._id;
}

docs {
  # Create Contact

  Creates a new contact for the authenticated user.

  ## Authentication

  Requires Bearer token authentication. The contact will be associated with the authenticated user.

  ## Request Body

  All fields are required.

  - `name` (string): The contact's full name
  - `email` (string): The contact's email address
  - `phone` (string): The contact's phone number (must be unique per user)

  ## Success Response (201 Created)

  ```json
  {
    "_id": "60d5ecb74b24c72b8c8b4567",
    "user_id": "60d5ecb74b24c72b8c8b4568",
    "name": "John Doe",
    "email": "john@example.com",
    "phone": "+1234567890",
    "__v": 0
  }
  ```

  ## Error Response (400 Bad Request)

  When required fields are missing:

  ```json
  {
    "message": "Please include all fields!"
  }
  ```

  When contact with same phone already exists:

  ```json
  {
    "message": "This contact has already been stored!"
  }
  ```

  ## Error Response (401 Unauthorized)

  When authentication token is missing or invalid:

  ```json
  {
    "message": "Please ensure to set the authorization header!"
  }
  ```
}